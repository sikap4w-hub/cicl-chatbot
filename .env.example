# Kopyahin ang file na ito bilang ".env" (walang ".example") sa parehong
# folder, tapos ilagay ang tunay mong Gemini API key sa ibaba.
# Kunin ang libreng key sa: https://aistudio.google.com -> "Get API key"
#
# HUWAG i-commit ang ".env" file sa git/GitHub -- naka-list na ito sa
# .gitignore para hindi ito ma-upload nang hindi sinasadya.

GEMINI_API_KEY=paste-your-key-here

# Opsyonal: palitan ang Gemini model na gagamitin (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
